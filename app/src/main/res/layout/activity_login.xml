<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="LoginActivity"
    android:orientation="vertical"
    android:background="@color/fondo_principal"
    android:padding="16dp"
    >
   <TextView
       android:id="@+id/title_login"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="Gestión de flota de Vehiculos"
       android:layout_gravity="center"
       android:textStyle="bold"
       android:textSize="20sp"
       android:textColor="@color/white"
app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toTopOf="parent"
       />

   <ImageView
       android:id="@+id/img_login"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toBottomOf="@id/title_login"
       android:layout_width="150dp"
       android:layout_height="150dp"
       android:src="@drawable/baseline_car_repair_24"
       app:layout_constraintBottom_toTopOf="@id/main_login"
       app:tint="@color/white"
       />

   <LinearLayout
       android:layout_marginTop="5dp"
       android:id="@+id/main_login"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toBottomOf="@id/img_login"
       app:layout_constraintBottom_toBottomOf="parent"
       >
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Nombre de la empresa:"
          android:textColor="@color/white"
          android:textSize="18sp"
           android:layout_marginBottom="5dp"

          />
      <EditText
   android:layout_marginVertical="10dp"
          android:id="@+id/et_name_company"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="Nombre del curso"
          android:textColorHint="@color/white"

          android:paddingVertical="12dp"
          android:paddingHorizontal="15dp"
          android:textColor="@color/white"
          android:background="@drawable/rounded_transparent" />
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Contraseña:"
          android:textColor="@color/white"
          android:textSize="18sp"
          android:layout_marginBottom="5dp"

          />
      <EditText
          android:layout_marginVertical="10dp"
          android:id="@+id/et_password"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="Digite la contraseña"
          android:textColorHint="@color/plumb"
   android:inputType="numberPassword"
          android:paddingVertical="10dp"
          android:paddingHorizontal="15dp"
          android:textColor="@color/white"
          android:background="@drawable/rounded_transparent" />
      <com.google.android.material.button.MaterialButton

          android:id="@+id/btn_register_login"
          app:cornerRadius="10dp"
          android:layout_marginTop="5dp"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="INGRSAR"
          android:textColor="@color/black"
          android:backgroundTint="@color/white"
          />


   </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>